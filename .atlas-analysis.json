  "keyFeatures": [
    "Typed locator paths with compile-time and runtime validation",
    "Automatic locator chaining via LocatorRegistry (getNestedLocator)",
    "Fluent locator registration DSL (add().getByRole().filter().nth())",
    "Non-mutating clone-based query overrides via getLocatorSchema()",
    "Reusable locator seeds for shared patterns across pages",
    "Abstract PageObject base class with navigation, sessionStorage, and registry wiring",
    "SessionStorage API with queueing and context-safe operations",
    "PlaywrightReportLogger with child loggers and HTML report attachment",
    "@step() decorator wrapping test methods in Playwright test.step",
    "Composable locator modules with TypeScript overload pattern"
  ],
  "publicApiSurface": [
    "PageObject (abstract class)",
    "createRegistryWithAccessors(page)",
    "LocatorRegistry<Paths>",
    "AddAccessor<Paths>",
    "GetLocatorAccessor<Paths>",
    "GetNestedLocatorAccessor<Paths>",
    "GetLocatorSchemaAccessor<Paths>",
    "SessionStorage",
    "PlaywrightReportLogger",
    "step() decorator",
    "test (Playwright fixture with log)",
    "NavigationOptions",
    "UrlTypeOptions",
    "BaseUrlTypeFromOptions",
    "UrlPathTypeFromOptions",
    "FullUrlTypeFromOptions",
    "LogEntry",
    "LogLevel"
  ]
}
