{
  "projectType": "sdk-library",
  "projectName": "POMWright",
  "projectDescription": "POMWright is a TypeScript companion framework for Playwright that formalizes Page Object Model workflows with a typed locator registry, automatic locator chaining, session storage helpers, structured logging, and a step decorator.",
  "theme": "luma",
  "primaryColor": "#ffcd00",
  "lightColor": "#ffffff",
  "darkColor": "#040404",
